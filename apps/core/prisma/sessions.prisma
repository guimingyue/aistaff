generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sessions"
}

datasource db {
  provider = "sqlite"
  url      = env("AISTAFF_SESSIONS_DATABASE_URL")
}

model Conversation {
  id               String   @id @default(cuid())
  employeeId       String
  channel          String? // DINGTALK | FEISHU | CONSOLE
  externalId       String? // 三方会话/群标识
  /// pi Agent 会话档案（jsonl 文件路径），用于跨轮次上下文延续
  agentSessionFile String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messages Message[]

  @@index([employeeId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  senderExternalUserId String?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}
