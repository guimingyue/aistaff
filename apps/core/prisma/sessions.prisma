generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sessions"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../../data/sessions.db"
}

model Conversation {
  id         String   @id @default(cuid())
  employeeId String
  channel    String? // DINGTALK | FEISHU | CONSOLE
  externalId String? // 三方会话/群标识
  createdAt  DateTime @default(now())

  messages Message[]

  @@index([employeeId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  senderExternalUserId String?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}
